---
import Base from '../layouts/Base.astro';
import Feed from '../components/Feed.astro';
import GrillaHistorias from '../components/GrillaHistorias.astro';
import { todasLasHistorias } from '../lib/historias';

const DESTACADAS = 6;
const RECIENTES = 18;
const historias = await todasLasHistorias();
---

<Base>
  <div class="contenedor intro">
    <h1 class="intro__titulo">Historias de El Salvador, grano a grano.</h1>
    <p class="intro__bajada">Crónicas, guías y cultura local. Sin suscripciones: pagás solo lo que leés.</p>
  </div>
  <Feed historias={historias.slice(0, DESTACADAS)} />
  <GrillaHistorias titulo="Más historias" historias={historias.slice(DESTACADAS, RECIENTES)} />
  {
    historias.length > RECIENTES && (
      <p class="contenedor mas">
        <a class="boton boton--oscuro" href="/archivo/">Ver las {historias.length} historias</a>
      </p>
    )
  }
</Base>

<style>
  .intro__titulo {
    max-width: 14ch;
    padding-block: clamp(32px, 6vw, 72px) 20px;
    font-size: var(--t-display);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .mas { margin-top: clamp(28px, 5vw, 56px); text-align: center; }

  .intro__bajada {
    max-width: 34ch;
    color: var(--tinta-suave);
    padding-bottom: clamp(28px, 5vw, 56px);
  }
</style>
